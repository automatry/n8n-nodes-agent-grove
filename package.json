{
	"name": "n8n-nodes-agent-grove",
	"version": "0.1.0",
	"description": "n8n community node for Agent Grove: run the AI agents hosted on your Agent Grove account",
	"license": "MIT",
	"homepage": "https://agent-grove.com",
	"bugs": {
		"url": "https://github.com/automatry/n8n-nodes-agent-grove/issues"
	},
	"keywords": [
		"n8n-community-node-package"
	],
	"author": {
		"name": "Automatry Ltd",
		"email": "support@automatry.com",
		"url": "https://agent-grove.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/automatry/n8n-nodes-agent-grove.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease",
		"test": "node --test test/*.test.mjs"
	},
	"files": [
		"dist/**/*.js",
		"dist/**/*.js.map",
		"dist/**/*.svg",
		"dist/nodes/**/*.json"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/AgentGroveApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/AgentGrove/AgentGrove.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.48.2",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"publishConfig": {
		"access": "public"
	}
}
